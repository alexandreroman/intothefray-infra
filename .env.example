# The .env of /opt/intothefray on the VPS. The deploy workflow writes it on
# every deploy (scripts/deploy.sh): never edit it by hand, run the workflow.

# Tag of ghcr.io/alexandreroman/intothefray that runs: the full 40-character
# commit SHA of the app repo. compose.yaml refuses to start without it.
APP_IMAGE_TAG=0123456789abcdef0123456789abcdef01234567

# The last different tag that ran before it (empty after the first deploy).
# For information only: compose.yaml does not read it. Roll back by running
# the workflow with this SHA.
APP_PREVIOUS_TAG=
